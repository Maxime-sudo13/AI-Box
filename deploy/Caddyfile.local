# Test sur un ordinateur : HTTP simple sur http://localhost:8080, rien d'exposé au réseau.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	handle /api/* {
		request_body {
			max_size 30MB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
