# Construit l'interface puis la sert avec Caddy, qui fait aussi office de reverse proxy.
FROM node:22-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM caddy:2.10-alpine
# Caddyfile (HTTPS sur le boîtier) ou Caddyfile.local (HTTP simple pour un test sur un PC).
ARG CADDYFILE=deploy/Caddyfile
COPY ${CADDYFILE} /etc/caddy/Caddyfile
COPY --from=build /src/dist /srv
