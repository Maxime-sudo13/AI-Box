# Mot de passe de la base PostgreSQL du boîtier (long et aléatoire).
BAB_DB_PASSWORD=
# Nom sous lequel le boîtier est joignable sur le réseau local.
BAB_HOSTNAME=businessaibox.local
# Modèle d'IA local (facultatif : sans modèle, le conseiller répond avec le moteur de calcul).
BAB_AI_MODEL=qwen2.5:7b
# Serveur d'envoi des courriels autorisés (facultatif).
BAB_SMTP_HOST=
BAB_SMTP_PORT=587
BAB_SMTP_USER=
BAB_SMTP_PASSWORD=
BAB_MAIL_FROM=
# Mode « zéro communication externe » (true par défaut). Voir docker-compose.connecteurs.yml.
BAB_OFFLINE_MODE=true
# Dossier de l'hôte surveillé par le connecteur « Dossier surveillé » (scanner, partage).
BAB_DEPOT_DIR=./depot
# Clé de chiffrement des identifiants (32 octets en base64) : openssl rand -base64 32
BAB_SECRET_KEY=
